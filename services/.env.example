# Cluster to read / write
RPC_URL=https://api.devnet.solana.com
# postgres://user:pass@host:5432/db (Supabase) or pglite:<dir> | pglite:memory
DATABASE_URL=pglite:./.data/indexer
# Must equal the Authorization header the webhook sender is configured with
WEBHOOK_SECRET=
# Keypair paths
PUBLISHER=~/.config/nundina/nav-publisher.json
PAYER=~/.config/solana/id.json
