# ── Cluster ────────────────────────────────────────────────────────────────
# devnet (default) | localnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=devnet
# Defaults: devnet → https://api.devnet.solana.com, localnet → http://127.0.0.1:8899
# NEXT_PUBLIC_RPC_URL=

# ── Deployment addresses (all required; public, not secrets) ────────────────
# Values for devnet live in .env. Source of truth: DEPLOYMENTS.md.
NEXT_PUBLIC_AUCTION_ENGINE_PROGRAM=
NEXT_PUBLIC_CREDIT_GATE_PROGRAM=
NEXT_PUBLIC_MARK_ENGINE_PROGRAM=
NEXT_PUBLIC_QUEUE_CLAIM_PROGRAM=
NEXT_PUBLIC_LIQUIDITY_FACILITY_PROGRAM=
NEXT_PUBLIC_TRANCHE_ENGINE_PROGRAM=
NEXT_PUBLIC_NPCS_TREASURY_PROGRAM=
NEXT_PUBLIC_PAYMENT_RAILS_PROGRAM=
# Solana Attestation Service (external program, never deployed by us)
NEXT_PUBLIC_SAS_PROGRAM=
# NPCS pilot mint (token/deployment-devnet.json)
NEXT_PUBLIC_NPCS_MINT=
# Squads v4 vault holding upgrade authority (ops/squads/deployment-devnet.json)
NEXT_PUBLIC_SQUADS_VAULT=

# ── Server-only (never NEXT_PUBLIC; set in Vercel, not in a committed file) ──
# Private allowlist (SRS 08 §7 Access). `allowlist` gates every page behind a
# wallet-signed sign-in + credit-gate admission; otherwise only /app/data-room
# and /app/admin are gated.
# NUNDINA_ACCESS=allowlist
# MACs the challenges and the access cookie; required (≥ 32 chars) for any sign-in.
# NUNDINA_ACCESS_SECRET=
# Operator / team wallets admitted without a gate check (comma-separated).
# NUNDINA_ALLOWLIST=
