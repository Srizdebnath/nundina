{
  "name": "@nundina/payment-rails-crank",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Settlement/refund crank, reconciliation ledger and cash-event evidence export for payment-rails (PHASES.md R4).",
  "scripts": {
    "crank": "tsx src/cli.ts",
    "typecheck": "tsc",
    "test": "tsx --test tests/*.spec.ts",
    "drill": "bash scripts/run-drill.sh",
    "sync-idl": "cp ../target/idl/payment_rails.json idl/payment_rails.json && cp ../../target/idl/auction_engine.json ../../target/idl/tranche_engine.json ../../target/idl/credit_gate.json ../../target/idl/mark_engine.json idl/"
  },
  "dependencies": {
    "@solana-program/compute-budget": "^0.19.0",
    "@solana-program/system": "^0.15.0",
    "@solana-program/token": "^0.17.0",
    "@solana/kit": "^8.3.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
