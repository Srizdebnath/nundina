# Which cluster the UI reads. devnet (default) | localnet | mainnet-beta
NEXT_PUBLIC_CLUSTER=devnet
# Defaults: devnet → https://api.devnet.solana.com, localnet → http://127.0.0.1:8899
# NEXT_PUBLIC_RPC_URL=
# The gated asset. Default: the devnet NPCS mint (token/deployment-devnet.json).
# For the local demo use the mint scripts/localnet.sh prints.
# NEXT_PUBLIC_NPCS_MINT=6vt1wHVQVuhnfJ3FtNbq4647mCjWUBmJCDABsYUgVKL4
