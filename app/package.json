{
  "name": "nundina-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint --max-warnings=0 .",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "sync-idl": "for p in auction_engine credit_gate mark_engine queue_claim liquidity_facility tranche_engine npcs_treasury; do cp ../target/idl/$p.json idl/; done && cp ../payment-rails/target/idl/payment_rails.json idl/",
    "localnet": "bash scripts/localnet.sh",
    "localnet:e2e": "NEXT_PUBLIC_CLUSTER=localnet tsx --tsconfig tsconfig.json scripts/localnet-e2e.mts",
    "access:e2e": "tsx --tsconfig tsconfig.json scripts/access-e2e.mts"
  },
  "dependencies": {
    "@solana/kit": "^8.4.0",
    "@solana/wallet-standard-features": "^1.5.0",
    "@wallet-standard/app": "^1.1.1",
    "@wallet-standard/base": "^1.1.1",
    "next": "^16",
    "react": "^19",
    "react-dom": "^19"
  },
  "devDependencies": {
    "@types/node": "^26",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.7"
  }
}
